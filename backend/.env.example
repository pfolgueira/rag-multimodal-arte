# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO (BACKEND)
# Copia este archivo como '.env' y ajusta los valores
# ==========================================

# --- Configuración de Seguridad y Red ---
# URL donde se ejecutará esta API (Local: http://localhost:8000 | Prod: https://tu-dominio.com)
API_PUBLIC_URL="http://localhost:8000"

# Orígenes permitidos para CORS (Separados por coma, sin barra al final)
ALLOWED_ORIGINS="https://rag-multimodal-arte.vercel.app/"

# API Key para utilizar el modelo de embeddings BGE-M3 desde OpenRouter
OPENROUTER_API_KEY="tu_api_key_aqui"

# --- Rutas de Archivos ---
# Ruta relativa o absoluta a la base de datos de ChromaDB
# En local: "../embeddings/chroma_db"
# En Render: "/opt/render/project/src/embeddings/chroma_db"
CHROMA_DB_PATH="../embeddings/chroma_db"

# Ruta relativa o absoluta a la carpeta con las imágenes del dataset
IMAGE_BASE_URL="../ruta/a/tus/imagenes"

# ==========================================
# NOTA PARA DESPLIEGUE EN RENDER
# ==========================================
# En Render, el repositorio se monta en /opt/render/project/src/
# Las variables de entorno deben configurarse en el dashboard de Render:
#   CHROMA_DB_PATH = /opt/render/project/src/embeddings/chroma_db
#   IMAGE_BASE_URL = https://tu-url-de-imagenes
#   ALLOWED_ORIGINS = https://tu-frontend.vercel.app
#   OPENROUTER_API_KEY = tu_api_key
#   API_PUBLIC_URL = https://tu-backend-en-render.onrender.com